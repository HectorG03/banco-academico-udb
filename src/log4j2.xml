<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <!-- Salida en consola de NetBeans -->
        <Console name="Consola" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} [%level] %c{1} - %msg%n"/>
        </Console>

        <!-- Salida en archivo físico dentro de la carpeta logs/ del proyecto -->
        <File name="ArchivoLog" fileName="logs/banco_academico.log" append="true">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} [%level] %c{1} - %msg%n"/>
        </File>
    </Appenders>

    <Loggers>
        <Root level="info">
            <AppenderRef ref="Consola"/>
            <AppenderRef ref="ArchivoLog"/>
        </Root>
    </Loggers>
</Configuration>